# Server
NODE_ENV=development
PORT=4000

# Database
MONGODB_URI=mongodb://localhost:27017/mern-auth-forge

# JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-string-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7

# CORS
CLIENT_ORIGIN=http://localhost:5173

# Password hashing
BCRYPT_SALT_ROUNDS=12

# Email (optional — leave blank to log reset links to the console instead
# of sending real email; see README "Email setup" for how to get a key)
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
